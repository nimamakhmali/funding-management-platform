# Django Core
SECRET_KEY=your-very-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_ENGINE=postgresql
DB_NAME=investment_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Throttle
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour
THROTTLE_AUTH=10/hour
THROTTLE_OTP=5/hour

# OTP
OTP_TTL_MINUTES=2
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMS
SMS_ENABLED=False
SMS_PROVIDER=none
SMS_KAVENEGAR_API_KEY=
SMS_KAVENEGAR_TEMPLATE=
SMS_FARAZSMS_BASE_URL=
SMS_FARAZSMS_API_KEY=
SMS_FARAZSMS_SENDER=

# SEJAM (Payment Settlement)
SEJAM_ENABLED=False
SEJAM_BASE_URL=
SEJAM_API_KEY=
SEJAM_TIMEOUT_SECONDS=20
SEJAM_CALLBACK_SECRET=a-random-shared-secret

# Localization
LANGUAGE_CODE=fa-ir
TIME_ZONE=Asia/Tehran

# --- Frontend / callback ---
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_PUBLIC_BASE_URL=http://localhost:8000


# --- Payment gateway sandbox flag (fallback) ---
ZARINPAL_SANDBOX=True

# --- Field encryption ---
FIELD_ENCRYPTION_KEY=generate-with-fernet-and-put-here
