<file path="investment_managment_project/components/pages/main/complete-user-information/SelectionCard.tsx">
import React from "react";

interface Props {
  id: string;
  name: string;
  value: string;
  icon: React.ReactNode;
  title: string;
  description: string;
  isChecked: boolean;
  onChange: (event: React.ChangeEvent<HTMLInputElement>) => void;
  disabled?: boolean;
  className?: string;
}

export default function SelectionCard({
  id,
  name,
  value,
  icon,
  title,
  description,
  isChecked,
  onChange,
  disabled = false,
  className = "",
}: Props) {
  const labelId = `${id}-label`;
  const descriptionId = `${id}-description`;

  return (
    <div className={`relative ${className}`}>
      <input
        type="radio"
        id={id}
        name={name}
        value={value}
        checked={isChecked}
        onChange={onChange}
        disabled={disabled}
        className="sr-only peer"
        aria-labelledby={labelId}
        aria-describedby={descriptionId}
