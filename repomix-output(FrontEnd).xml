  end_date: string;
  remaining_days: number;               // ← جدید
  status: BackendProjectStatus;
  status_display: string;
  funding_percentage: string;
  is_funding_complete: boolean;
  investors_count: number;              // ← جدید
  documents: ProjectDocument[];         // ← جدید (فقط در detail)
