// components/pages/investment-panel/invest-wallet/investWalletCard.tsx
"use client";

import Card from "@/components/ui/Card";
import { TrendingUp, Wallet } from "lucide-react";
import { useWallet, useTransactions } from "@/lib/hooks/useInvestorDashboard";

function fmt(val: string | number): string {
  const n = typeof val === "string" ? parseFloat(val) : val;
  if (isNaN(n)) return "۰";
  return n.toLocaleString("fa-IR");
}

export default function WalletCards() {
  const { data: wallet, isLoading } = useWallet();

  // سود در انتظار = تراکنش‌های PROFIT که هنوز به‌حساب نرسیده
  const { data: profitTx } = useTransactions({
    page: 1,
    page_size: 100,
    type: "PROFIT",
    success: false,
  });

  const pendingProfit =
    profitTx?.results?.reduce(
      (sum, tx) => sum + parseFloat(tx.amount),
      0
    ) ?? 0;

  const balance = fmt(wallet?.available_balance ?? "0");
  const pending = fmt(pendingProfit);

  return (
    <div className="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div className="relative">
        <div className="absolute right-0 top-0 bottom-0 w-1.5 bg-primary rounded-r-full z-10" />
        <Card
          data={{
            title: "موجودی قابل استفاده",
            value: isLoading ? "..." : balance,
            unit: "تومان",
            icon: Wallet,
          }}
          mapping={{
            title: "title",
            value: "value",
            unit: "unit",
            icon: "icon",
          }}
          iconPosition="header"
        />
      </div>

      <Card
        data={{
          title: "سود در انتظار",
          value: isLoading ? "..." : pending,
          unit: "تومان",
          icon: TrendingUp,
        }}
        mapping={{
          title: "title",
          value: "value",
          unit: "unit",
          icon: "icon",
        }}
        iconPosition="header"
        className="p-4"
      />
    </div>
  );
}
</file>

<file path="investment_managment_project/components/pages/investment-panel/invest-wallet/Request-management.tsx">
// components/pages/investment-panel/invest-wallet/Request-management.tsx
"use client";

import { useState } from "react";
import { Mail, Plus } from "lucide-react";
import { Button } from "../../../ui/button";
import { useWithdrawal, useWallet } from "@/lib/hooks/useInvestorDashboard";

export default function RequestManagement() {
  const [showForm, setShowForm] = useState(false);
  const [amount, setAmount] = useState("");
  const [error, setError] = useState("");

  const { data: wallet } = useWallet();
  const withdrawMutation = useWithdrawal();

  const handleWithdraw = () => {
    const num = parseFloat(amount.replace(/,/g, ""));
    const available = parseFloat(wallet?.available_balance ?? "0");

    if (!num || num <= 0) {
      setError("مبلغ را وارد کنید");
      return;
    }
    if (num > available) {
      setError("مبلغ از موجودی قابل استفاده بیشتر است");
      return;
    }

    setError("");
    withdrawMutation.mutate(num, {
      onSuccess: () => {
        setShowForm(false);
        setAmount("");
      },
      onError: () => {
        setError("خطا در ثبت درخواست برداشت");
      },
    });
  };

  return (
    <div className="bg-white rounded-2xl border border-gray-100 shadow-md p-1 overflow-hidden relative">
      <div className="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 p-6 relative z-10">
        <div className="flex items-start gap-5">
          <div className="hidden md:flex items-center justify-center w-14 h-14 rounded-2xl bg-purple-200 text-primary">
            <Mail />
          </div>

          <div className="flex flex-col gap-1 text-gray-900">
            <h3 className="text-lg font-bold">مدیریت برداشت</h3>
            <p className="text-sm leading-relaxed">
              موجودی قابل برداشت:{" "}
              <span className="font-bold text-primary">
                {parseFloat(
                  wallet?.available_balance ?? "0"
                ).toLocaleString("fa-IR")}{" "}
                تومان
              </span>
            </p>
          </div>
        </div>

        <Button
          className="flex items-center gap-2 sm:w-auto text-gray-50"
          size="lg"
          onClick={() => setShowForm(!showForm)}
        >
          <Plus className="h-4 w-4" />
          درخواست برداشت وجه
        </Button>
      </div>

      {/* فرم برداشت */}
      {showForm && (
        <div className="px-6 pb-6 flex flex-col sm:flex-row gap-3">
          <input
            type="number"
            value={amount}
            onChange={(e) => setAmount(e.target.value)}
            placeholder="مبلغ برداشت (تومان)"
            className="flex-1 h-11 rounded-lg border border-gray-200 px-4 text-sm outline-none focus:border-primary"
          />
          <Button
            onClick={handleWithdraw}
            disabled={withdrawMutation.isPending}
            className="h-11 px-6"
          >
            {withdrawMutation.isPending ? "در حال ثبت..." : "تأیید برداشت"}
          </Button>
        </div>
      )}

      {error && (
        <p className="px-6 pb-4 text-sm text-red-500">{error}</p>
      )}

      {withdrawMutation.isSuccess && (
        <p className="px-6 pb-4 text-sm text-green-600">
          درخواست برداشت با موفقیت ثبت شد.
        </p>
      )}
    </div>
  );
}
</file>

<file path="investment_managment_project/components/pages/investment-panel/invest-wallet/walletTransactionTable.tsx">
// components/pages/investment-panel/invest-wallet/walletTransactionTable.tsx
"use client";

import { useState } from "react";
import { ReusableTable } from "@/components/ui/ReusableTable";
import ProjectStatus from "@/components/ui/statusBadge";
import { Button } from "@/components/ui/button";
import { ArrowLeft } from "lucide-react";
import { useTransactions } from "@/lib/hooks/useInvestorDashboard";
import Link from "next/link";

// ── نگاشت نوع تراکنش بک‌اند → فارسی ─────────────────────────────────────────
const TYPE_LABEL: Record<string, string> = {
  DEPOSIT: "واریز",
  WITHDRAWAL: "برداشت",
  INVESTMENT_COMMITMENT: "سرمایه‌گذاری",
  PROFIT: "سود",
  REFUND: "استرداد",
};

// ── نگاشت وضعیت برای statusBadge ─────────────────────────────────────────────
function txStatus(tx: {
  is_successful: boolean;
  type: string;
}): string {
  if (tx.is_successful) return "موفق";
  if (tx.type === "WITHDRAWAL") return "در انتظار";
  return "ناموفق";
}

export default function WalletTransactionTable() {
  const [currentPage, setCurrentPage] = useState(1);
  const PAGE_SIZE = 5;

  const { data, isLoading } = useTransactions({
    page: currentPage,
    page_size: PAGE_SIZE,
  });

  const rows = (data?.results ?? []).map((tx) => ({
    id: tx.id,
    date: new Date(tx.created_at).toLocaleDateString("fa-IR"),
    time: new Date(tx.created_at).toLocaleTimeString("fa-IR", {
      hour: "2-digit",
      minute: "2-digit",
    }),
    type: TYPE_LABEL[tx.type] ?? tx.type,
    description: tx.reference_id ?? "-",
    amount: parseFloat(tx.amount),
    status: txStatus(tx),
  }));

  if (isLoading) {
    return (
      <div className="animate-pulse space-y-3">
        {Array.from({ length: 3 }).map((_, i) => (
          <div key={i} className="h-12 bg-gray-100 rounded-lg" />
        ))}
      </div>
    );
  }

  return (
    <div className="space-y-4">
      <div className="flex justify-end text-primary">
        <Link href="/transaction-history">
          <Button variant="ghost" size="sm">
            مشاهده همه تراکنش‌ها
            <ArrowLeft />
          </Button>
        </Link>
      </div>

      <ReusableTable
        data={rows}
        columns={[
          {
            header: "تاریخ و زمان",
            cellClassName: "py-4",
            accessor: (row) => `${row.date} ساعت ${row.time}`,
          },
          {
            header: "نوع تراکنش",
            accessor: "type",
          },
          {
            header: "شرح تراکنش",
            accessor: "description",
          },
          {
            header: "مبلغ",
            accessor: (row) =>
              row.amount.toLocaleString("fa-IR") + " تومان",
          },
          {
            header: "وضعیت",
            accessor: (row) => <ProjectStatus status={row.status} />,
          },
        ]}
        title="لیست تراکنش‌ها"
        enablePagination
        itemsPerPage={PAGE_SIZE}
        currentPage={currentPage}
        onPageChange={setCurrentPage}
      />
    </div>
  );
}
</file>

<file path="investment_managment_project/components/pages/investment-panel/investment-projects/InvestmentProjectAmount.tsx">
"use client";

import { useState } from "react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Checkbox } from "@/components/ui/checkbox";
import { Label } from "@/components/ui/label";
import Card from "@/components/ui/Card";
import { toPersianNumber } from "@/lib/utils/Numberformat";
import { useInvest } from "@/lib/hooks/useInvestorDashboard";
import { useRouter } from "next/navigation";

interface Props {
  projectId: string;
  minAmount: number;
  maxAmount: number;
  balance: number;
}

export function InvestmentProjectAmountConnected({
  projectId,
  minAmount,
  maxAmount,
  balance,
}: Props) {
  const [amount, setAmount] = useState(minAmount);
  const [agreed, setAgreed] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const router = useRouter();
  const { mutate: invest, isPending } = useInvest();

  const quickButtons = [
    { label: `+ ${toPersianNumber(1_000_000)}`, amount: 1_000_000 },
    { label: `+ ${toPersianNumber(5_000_000)}`, amount: 5_000_000 },
    { label: `+ ${toPersianNumber(10_000_000)}`, amount: 10_000_000 },
  ];

  function handleAdd(val: number) {
    setAmount((prev) => Math.min(prev + val, maxAmount));
    setError(null);
  }

  function handleMax() {
    setAmount(Math.min(balance, maxAmount));
    setError(null);
  }

  function handleChange(e: React.ChangeEvent<HTMLInputElement>) {
    const val = parseFloat(e.target.value) || 0;
    setAmount(val);
    setError(null);
  }

  function handleSubmit() {
    if (!agreed) {
      setError("لطفاً شرایط و قوانین را بپذیرید.");
      return;
    }
    if (amount < minAmount) {
      setError(`حداقل مبلغ سرمایه‌گذاری ${toPersianNumber(minAmount)} تومان است.`);
      return;
    }
    if (amount > maxAmount) {
      setError(`حداکثر مبلغ سرمایه‌گذاری ${toPersianNumber(maxAmount)} تومان است.`);
      return;
    }
    if (amount > balance) {
      setError("موجودی کیف پول کافی نیست.");
      return;
    }

    invest(
      { project_id: projectId, amount },
      {
        onSuccess: () => {
          router.push("/payment-result?status=success");
        },
        onError: (err: unknown) => {
          const msg =
            (err as { response?: { data?: { message?: string } } })
              ?.response?.data?.message ?? "خطا در ثبت سرمایه‌گذاری";
          setError(msg);
        },
      }
    );
  }

  const investmentData = {
    title: "مبلغ سرمایه‌گذاری",
    value: amount,
    unit: "تومان",
    balance,
    minAmount,
    maxAmount,
  };

  return (
    <Card
      data={investmentData}
      mapping={{ title: "title", value: "value", unit: "unit" }}
      renderTitle={(title) => (
        <div className="flex justify-between items-center w-full flex-wrap gap-2">
          <h3 className="text-lg font-bold text-text-main">{title}</h3>
          <div className="flex items-center gap-1.5 text-primary text-sm bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-100">
            <span>موجودی: </span>
            <span className="text-text-main font-bold">
              {toPersianNumber(balance)}
            </span>
            <span>تومان</span>
          </div>
        </div>
      )}
      renderValue={(value, unit) => (
        <div className="relative group mt-8">
          <Label className="absolute -top-3 right-4 bg-white px-2 text-xs font-medium text-primary -mt-2">
            مبلغ به تومان
          </Label>
          <div className="relative flex items-center">
            <Input
              className="block w-full rounded-xl py-2 pr-4 pl-16 text-right text-2xl font-bold shadow-sm border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary outline-none transition-all"
              placeholder="0"
              type="number"
              value={amount}
              onChange={handleChange}
              min={minAmount}
              max={maxAmount}
            />
            <div className="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
              <span className="text-gray-400 font-medium">{unit}</span>
            </div>
          </div>
          <div className="mt-2 flex justify-between items-center text-[11px] text-text-secondary">
            <span>Min: {toPersianNumber(minAmount)}</span>
            <span>Max: {toPersianNumber(maxAmount)}</span>
          </div>
        </div>
      )}
      renderFooter={() => (
        <div className="w-full mt-4 space-y-6">
          <div className="flex flex-wrap gap-2">
            {quickButtons.map((btn) => (
              <Button
                key={btn.label}
                variant="outline"
                type="button"
                onClick={() => handleAdd(btn.amount)}
                className="px-4 py-2 rounded-full border border-gray-200 bg-gray-50 text-xs font-medium text-primary hover:border-primary hover:text-primary transition-all hover:bg-primary/5"
              >
                {btn.label}
              </Button>
            ))}
            <Button
              variant="outline"
              type="button"
              onClick={handleMax}
              className="px-4 py-2 rounded-full border border-gray-200 bg-gray-50 text-xs font-medium text-primary hover:border-primary hover:text-primary transition-all hover:bg-primary/5"
            >
              حداکثر
            </Button>
          </div>

          {error && (
            <p className="text-red-500 text-xs bg-red-50 px-3 py-2 rounded-lg">
              {error}
            </p>
          )}

          <div className="pt-6 border-t border-gray-200">
            <div className="flex gap-3 items-start p-4 rounded-xl">
              <div className="flex h-6 items-center">
                <Checkbox
                  id="terms"
                  className="border border-gray-300"
                  checked={agreed}
                  onCheckedChange={(v) => setAgreed(!!v)}
                />
              </div>
              <div className="text-sm leading-6">
                <Label
                  htmlFor="terms"
                  className="font-bold text-text-main cursor-pointer"
                >
                  شرایط و قوانین را می‌پذیرم
                </Label>
                <p className="text-gray-800 mt-3 text-xs">
                  با پرداخت این مبلغ، شما قرارداد مشارکت در پروژه را امضا
                  می‌کنید.
                </p>
              </div>
            </div>
          </div>

          <Button
            onClick={handleSubmit}
            disabled={isPending || !agreed}
            className="w-full bg-primary text-white font-bold text-base py-6 rounded-xl shadow-lg transition-all"
          >
            {isPending ? "در حال پردازش..." : "پرداخت و ثبت سرمایه‌گذاری"}
          </Button>
        </div>
      )}
    />
  );
}
</file>

