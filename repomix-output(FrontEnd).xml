<file path="investment_managment_project/components/pages/investment-panel/ticket-management/TicketDetailWrapper.tsx">
// components/pages/investment-panel/ticket-management/TicketDetailWrapper.tsx
"use client";

import { useTicketDetail, useReplyTicket, useCloseTicket } from "@/lib/hooks/useTickets";
import { useAuthStore } from "@/lib/store/auth.store";
import { mapTicketDetail, mapMessage } from "@/lib/utils/ticket.utils";
import TicketDetail from "./TicketDetail";
import TicketDetailHeader from "./TicketDetailHeader";
import TicketChat from "./TicketChat";
import TicketReplyBox from "./TicketReplyBox";
import type { BackendTicketMessage } from "@/lib/api/services/ticket.service";

interface Props {
  id: string;
}

function SkeletonDetail() {
  return (
    <div className="animate-pulse space-y-4 p-6">
      <div className="h-8 bg-gray-100 rounded w-1/3" />
      <div className="h-40 bg-gray-100 rounded" />
      <div className="h-20 bg-gray-100 rounded" />
    </div>
  );
}

export default function TicketDetailWrapper({ id }: Props) {
  const user = useAuthStore((s) => s.user);
  const { data: backendTicket, isLoading, refetch } = useTicketDetail(id);
  const replyMutation = useReplyTicket(id);
  const closeMutation = useCloseTicket();

  if (isLoading) return <SkeletonDetail />;

  if (!backendTicket) {
    return (
      <div className="text-center py-16 text-gray-400 text-sm">
        تیکت یافت نشد
      </div>
    );
  }

  const currentUserId = user?.id ?? "";
  const ticket = mapTicketDetail(backendTicket, currentUserId);

  const handleSend = async (text: string) => {
    replyMutation.mutate(
      { message: text },
      { onSuccess: () => refetch() }
    );
  };

  const handleClose = async () => {
    closeMutation.mutate(id, {
      onSuccess: () => refetch(),
    });
  };

  return (
    <div className="mx-auto flex w-full max-w-[1600px] flex-1 flex-col">
      {/* هدر با قابلیت بستن تیکت */}
      <TicketDetailHeader
        ticket={ticket}
        onClose={
          ticket.status !== "closed" ? handleClose : undefined
        }
        isClosing={closeMutation.isPending}
      />

      <div className="relative flex flex-1 flex-col overflow-hidden rounded-xl border border-border bg-surface shadow-sm">
        <TicketChat messages={ticket.messages} />

        {/* فقط وقتی تیکت بسته نیست، باکس reply نشان بده */}
        {ticket.status !== "closed" && (
          <TicketReplyBox
            onSend={handleSend}
            isSending={replyMutation.isPending}
          />
        )}

        {ticket.status === "closed" && (
          <div className="p-4 text-center text-sm text-gray-400 border-t border-border">
            این تیکت بسته شده است
          </div>
        )}
      </div>
    </div>
  );
}
</file>

<file path="investment_managment_project/components/pages/investment-panel/ticket-management/TicketList.tsx">
"use client";

import { zodResolver } from "@hookform/resolvers/zod";
import { Plus, RotateCcw } from "lucide-react";
import { useMemo, useState } from "react";
import { FormProvider, useForm, useWatch } from "react-hook-form";
import Link from "next/link";

import { FormInputField } from "@/components/ui/FormInputField";
import { FormScrollableSelectField } from "@/components/ui/FormScrollableSelectField";
import {
  ticketFilterSchema,
  type TicketFilterValues,
} from "@/lib/validation/investment-panel/ticket-management/ticketFilterSchema";
import { useTickets } from "@/lib/hooks/useTickets";
import { mapTicket } from "@/lib/utils/ticket.utils";
import TicketTable from "./TicketTable";

type FilterOption = { value: string; label: string };

const statusOptions: FilterOption[] = [
  { value: "all", label: "همه وضعیت‌ها" },
  { value: "open", label: "باز" },
  { value: "in_progress", label: "در حال انجام" },
  { value: "closed", label: "بسته شده" },
];

const timeRangeOptions: FilterOption[] = [
  { value: "all", label: "همه زمان‌ها" },
  { value: "today", label: "امروز" },
  { value: "last_week", label: "هفته گذشته" },
  { value: "last_month", label: "ماه گذشته" },
];

export default function TicketList() {
  const [currentPage, setCurrentPage] = useState(1);
  const PAGE_SIZE = 10;

  // ── داده واقعی از API ─────────────────────────────────────────────────────
  const { data, isLoading } = useTickets({
    page: currentPage,
    page_size: PAGE_SIZE,
  });

  const methods = useForm<TicketFilterValues>({
    resolver: zodResolver(ticketFilterSchema),
    defaultValues: { search: "", status: "all", timeRange: "all" },
  });

  const { reset } = methods;
  const search = useWatch({ control: methods.control, name: "search" });
  const status = useWatch({ control: methods.control, name: "status" });

  // ── mapping و فیلتر ───────────────────────────────────────────────────────
  const tickets = useMemo(() => {
    const raw = (data?.results ?? []).map(mapTicket);

    return raw.filter((ticket) => {
      const matchesSearch =
        !search ||
        ticket.title.includes(search) ||
        ticket.id.includes(search);
      const matchesStatus =
        status === "all" || ticket.status === status;
      return matchesSearch && matchesStatus;
    });
  }, [data, search, status]);

  return (
    <div className="max-w-[1200px] mx-auto flex flex-col gap-6">
      <div className="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div className="flex flex-col gap-1">
          <h1 className="text-3xl font-black text-[#131118] tracking-tight">
            لیست تیکت‌ها
          </h1>
          <p className="text-gray-500 text-sm font-normal">
            مدیریت تیکت‌های پشتیبانی و پیگیری سابقه درخواست‌ها
          </p>
        </div>
        <Link
          href="/invest-support/create"
          className="bg-primary hover:bg-primary-dark text-white h-10 px-6 rounded-lg font-bold text-sm flex items-center gap-2 shadow-lg shadow-primary/30 transition-all active:scale-95 shrink-0"
        >
          <Plus size={20} />
          ایجاد تیکت جدید
        </Link>
      </div>

      <FormProvider {...methods}>
        <form
          onSubmit={(e) => e.preventDefault()}
          className="bg-white p-4 rounded-xl border border-[#dedbe6] shadow-sm flex flex-wrap items-end gap-4"
        >
          <div className="relative flex-1 min-w-[240px]">
            <FormInputField<TicketFilterValues>
              name="search"
              control={methods.control}
              placeholder="عنوان تیکت یا شناسه پیگیری..."
              className="pr-10"
            />
          </div>

          <div className="w-48">
            <FormScrollableSelectField<TicketFilterValues, FilterOption>
              name="status"
              control={methods.control}
              options={statusOptions}
              getOptionLabel={(o) => o.label}
              getOptionValue={(o) => o.value}
              placeholder="همه وضعیت‌ها"
            />
          </div>

          <div className="w-48">
            <FormScrollableSelectField<TicketFilterValues, FilterOption>
              name="timeRange"
              control={methods.control}
              options={timeRangeOptions}
              getOptionLabel={(o) => o.label}
              getOptionValue={(o) => o.value}
              placeholder="همه زمان‌ها"
            />
          </div>

          <button
            type="button"
            onClick={() =>
              reset({ search: "", status: "all", timeRange: "all" })
            }
            className="text-sm font-bold text-gray-500 hover:text-primary transition-colors px-3 py-2 rounded-lg hover:bg-gray-50 flex items-center gap-1"
          >
            <RotateCcw size={18} />
            بازنشانی
          </button>
        </form>
      </FormProvider>

      {isLoading ? (
        <div className="animate-pulse space-y-3">
          {Array.from({ length: 5 }).map((_, i) => (
            <div key={i} className="h-16 bg-gray-100 rounded-lg" />
          ))}
        </div>
      ) : tickets.length === 0 ? (
        <div className="text-center py-16 text-gray-400 text-sm">
          تیکتی یافت نشد
        </div>
      ) : (
        <TicketTable data={tickets} />
      )}
    </div>
  );
}
</file>

