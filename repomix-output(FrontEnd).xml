              <input
                {...register("maxCapital")}
                placeholder="حداکثر"
                className="h-11 rounded-xl border border-border bg-white px-3 text-sm focus:border-primary focus:outline-none"
              />
            </div>
          </div>

          <div className="rounded-xl border border-border bg-gray-50 p-4 space-y-2">
