                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    USER {\n        UUID id PK\n        string mobile\n        string email\n        string password_hash\n        boolean is_active\n        boolean is_verified\n        boolean is_admin\n        boolean is_operator\n        datetime last_login\n        datetime created_at\n    }\n\n    USER_PROFILE {\n        bigint id PK\n        UUID user_id FK\n        string full_name\n        string national_id\n        string iban\n        string risk_level\n        datetime created_at\n    }\n\n    ROLE {\n        smallint id PK\n        string name\n    }\n\n    USER_ROLE {\n        bigint id PK\n        UUID user_id FK\n        smallint role_id FK\n        datetime assigned_at\n    }\n\n    PROJECT {\n        UUID id PK\n        UUID owner_id FK\n        string title\n        string slug\n        text description\n        string status\n        datetime published_at\n        datetime created_at\n    }\n\n    PROJECT_FINANCIAL_SNAPSHOT {\n        UUID project_id PK, FK\n        bigint target_amount\n        bigint collected_amount\n        int investor_count\n        datetime updated_at\n    }\n\n    PROJECT_STAGE {\n        bigint id PK\n        UUID project_id FK\n        string title\n        text description\n        int stage_order\n        int progress_percent\n        datetime created_at\n    }\n\n    PROJECT_DOCUMENT {\n        bigint id PK\n        UUID project_id FK\n        string file_path\n        string document_type\n        datetime uploaded_at\n    }\n\n    PROJECT_STATUS_HISTORY {\n        bigint id PK\n        UUID project_id FK\n        string from_status\n        string to_status\n        UUID changed_by FK\n        datetime created_at\n    }\n\n    INVESTMENT {\n        UUID id PK\n        UUID user_id FK\n        UUID project_id FK\n        bigint amount\n        int units\n        string status\n        datetime created_at\n    }\n\n    WALLET {\n        bigint id PK\n        UUID user_id FK\n        bigint balance\n        datetime updated_at\n    }\n\n    TRANSACTION {\n        UUID id PK\n        bigint wallet_id FK\n        UUID investment_id FK\n        bigint amount\n        string transaction_type\n        string status\n        string gateway_ref\n        datetime created_at\n    }\n\n    PROFIT_PERIOD {\n        bigint id PK\n        UUID project_id FK\n        date start_date\n        date end_date\n        bigint total_profit\n        string status\n        datetime created_at\n    }\n\n    PROFIT_DISTRIBUTION {\n        bigint id PK\n        bigint profit_period_id FK\n        UUID user_id FK\n        UUID investment_id FK\n        bigint profit_amount\n        string status\n    }\n\n    TICKET {\n        bigint id PK\n        UUID user_id FK\n        string subject\n        string status\n        datetime created_at\n    }\n\n    TICKET_MESSAGE {\n        bigint id PK\n        bigint ticket_id FK\n        UUID sender_id FK\n        text message\n        datetime created_at\n    }\n\n    NOTIFICATION {\n        bigint id PK\n        UUID user_id FK\n        string title\n        text body\n        boolean is_read\n        datetime created_at\n    }\n\n    OTP {\n        bigint id PK\n        UUID user_id FK\n        string code\n        datetime expires_at\n        boolean is_used\n    }\n\n    AUDIT_LOG {\n        bigint id PK\n        UUID user_id FK\n        string action\n        string entity\n        UUID entity_id\n        string ip_address\n        datetime created_at\n    }\n\n    SYSTEM_SETTING {\n        smallint id PK\n        string setting_key\n        string setting_value\n    }\n\n    USER ||--|| USER_PROFILE : has\n    USER ||--o{ USER_ROLE : assigned\n    ROLE ||--o{ USER_ROLE : contains\n\n    USER ||--o{ PROJECT : owns\n    PROJECT ||--|| PROJECT_FINANCIAL_SNAPSHOT : has\n    PROJECT ||--o{ PROJECT_STAGE : includes\n    PROJECT ||--o{ PROJECT_DOCUMENT : has\n    PROJECT ||--o{ PROJECT_STATUS_HISTORY : tracks\n\n    USER ||--o{ INVESTMENT : makes\n    PROJECT ||--o{ INVESTMENT : receives\n\n    USER ||--|| WALLET : owns\n    WALLET ||--o{ TRANSACTION : logs\n    INVESTMENT ||--o{ TRANSACTION : generates\n\n    PROJECT ||--o{ PROFIT_PERIOD : defines\n    PROFIT_PERIOD ||--o{ PROFIT_DISTRIBUTION : distributes\n    USER ||--o{ PROFIT_DISTRIBUTION : receives\n    INVESTMENT ||--o{ PROFIT_DISTRIBUTION : based_on\n\n    USER ||--o{ TICKET : creates\n    TICKET ||--o{ TICKET_MESSAGE : contains\n    USER ||--o{ TICKET_MESSAGE : writes\n\n    USER ||--o{ NOTIFICATION : receives\n    USER ||--o{ OTP : authenticates\n    USER ||--o{ AUDIT_LOG : triggers\n&quot;&#xa;}" id="3">
