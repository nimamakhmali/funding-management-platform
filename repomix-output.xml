    ProjectStatus.FUNDING_COMPLETED,
    ProjectStatus.ACTIVE,
    ProjectStatus.COMPLETED,
]

ACTIVE_STATUSES = [
    ProjectStatus.FUNDING,
    ProjectStatus.ACTIVE,
    ProjectStatus.APPROVED,
]


