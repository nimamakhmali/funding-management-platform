            />

            <XAxis
              dataKey="month"
              axisLine={false}
              tickLine={false}
              tickMargin={12}
              tick={{ fontSize: 12 }}
            />

            <ChartTooltip
              cursor={false}
              content={
                <ChartTooltipContent
                  indicator="line"
                />
              }
            />

            <Area
              type="monotone"
              dataKey="progress"
              stroke="var(--color-progress)"
              strokeWidth={3}
              fill="url(#fillProgress)"
              dot={false}
              activeDot={{ r: 5 }}
              animationDuration={900}
            />
          </AreaChart>
        </ChartContainer>
      </div>
    </section>
  );
}
