    created_at = models.DateTimeField(auto_now_add=True, db_index=True)

    class Meta:
        db_table = "project_status_history"
        ordering = ["-created_at"]


class DocumentType(models.TextChoices):
    LEGAL = "LEGAL", "حقوقی"
    FINANCIAL = "FINANCIAL", "مالی"
    TECHNICAL = "TECHNICAL", "فنی"
    OTHER = "OTHER", "سایر"


class Document(models.Model):
    id = models.UUIDField(primary_key=True, default=uuid.uuid4, editable=False)
    project = models.ForeignKey(
        Project, on_delete=models.CASCADE,
        related_name="documents", db_index=True,
    )
    uploader = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        on_delete=models.SET_NULL, null=True, blank=True,
    )
    title = models.CharField(max_length=255)
    doc_type = models.CharField(
        max_length=20,
        choices=DocumentType.choices,
        default=DocumentType.OTHER,
    )
    file = models.FileField(
        upload_to="project_documents/%Y/%m/",
        validators=[validate_document_file],
    )
    created_at = models.DateTimeField(auto_now_add=True)

    class Meta:
        db_table = "project_documents"
        indexes = [models.Index(fields=["project"])]

    @property
    def file_url(self) -> str | None:
        if self.file:
            return self.file.url
        return None

    @property
    def file_size_display(self) -> str:
        """نمایش حجم فایل به صورت خوانا"""
        if not self.file:
            return ""
        try:
            size = self.file.size
            if size < 1024:
                return f"{size} B"
            elif size < 1024 * 1024:
                return f"{size / 1024:.1f} KB"
            else:
                return f"{size / (1024 * 1024):.1f} MB"
        except Exception:
            return ""

    @property
    def file_extension(self) -> str:
        """پسوند فایل برای نمایش آیکون"""
        if not self.file:
            return ""
        name = self.file.name or ""
        return name.rsplit(".", 1)[-1].lower() if "." in name else ""
