function ChartSkeleton() {
  return (
    <div className="h-72 w-full animate-pulse flex items-end gap-3 px-4">
      {Array.from({ length: 6 }).map((_, i) => (
        <div
          key={i}
          className="flex-1 bg-gray-100 rounded-t-lg"
          style={{ height: `${40 + Math.random() * 60}%` }}
        />
      ))}
