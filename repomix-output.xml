            {row.department}
          </span>
        </div>
      ),
      cellClassName: "px-6 py-4 whitespace-nowrap",
    },
    {
      header: "وضعیت",
      accessor: (row) => <TicketStatusBadge status={row.status} />,
      filterable: true,
      filterType: "select",
      filterOptions: [
        { value: "open", label: "باز" },
        { value: "in_progress", label: "در حال انجام" },
        { value: "closed", label: "بسته شده" },
