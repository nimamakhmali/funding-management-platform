  return (
    <span
      className={cn(
        "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold",
        config.className,
      )}
    >
      {config.pulse ? (
        <span className="size-1.5 rounded-full bg-blue-500 animate-pulse" />
      ) : (
        <Icon className="text-[14px]" size={14} />
      )}
      {config.label}
    </span>
  );
}
