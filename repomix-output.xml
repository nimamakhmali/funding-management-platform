}

// ── Helper ────────────────────────────────────────────────────────────────────
interface ApiResponse<T> { success: boolean; data: T; }

function unwrap<T>(response: { data: ApiResponse<T> | T }): T {
  const p = response.data;
  if (p && typeof p === "object" && "data" in p && "success" in p) {
    return (p as ApiResponse<T>).data;
  }
  return p as T;
}

// ── Service ───────────────────────────────────────────────────────────────────
export const projectsService = {
  getProjects: async (params?: ProjectListParams): Promise<PaginatedProjects> => {
    const res = await axiosInstance.get("/projects/", { params });
    return unwrap<PaginatedProjects>(res);
  },

  getProjectById: async (id: string): Promise<BackendProject> => {
    const res = await axiosInstance.get(`/projects/${id}/`);
    return unwrap<BackendProject>(res);
  },

  createProject: async (data: FormData): Promise<BackendProject> => {
    const res = await axiosInstance.post("/projects/", data, {
      headers: { "Content-Type": "multipart/form-data" },
    });
    return unwrap<BackendProject>(res);
  },

  updateProject: async (id: string, data: FormData | object): Promise<BackendProject> => {
    const isFormData = data instanceof FormData;
    const res = await axiosInstance.patch(`/projects/${id}/`, data, {
      headers: isFormData ? { "Content-Type": "multipart/form-data" } : {},
    });
    return unwrap<BackendProject>(res);
  },

  deleteProject: async (id: string): Promise<void> => {
    await axiosInstance.delete(`/projects/${id}/`);
  },

  changeStatus: async (
    id: string,
    to_status: BackendProjectStatus,
    reason?: string,
  ): Promise<BackendProject> => {
    const res = await axiosInstance.post(`/projects/${id}/change_status/`, {
      to_status, reason,
    });
    return unwrap<BackendProject>(res);
  },

  uploadDocument: async (
    id: string,
    data: { title: string; doc_type: string; file: File },
  ): Promise<ProjectDocument> => {
    const formData = new FormData();
    formData.append("title", data.title);
    formData.append("doc_type", data.doc_type);
    formData.append("file", data.file);
    const res = await axiosInstance.post(`/projects/${id}/documents/`, formData, {
      headers: { "Content-Type": "multipart/form-data" },
    });
    return unwrap<ProjectDocument>(res);
  },
};
</file>

<file path="investment_platform_FrontEnd/investment_managment_project/lib/api/services/ticket.service.ts">
import axiosInstance from "@/lib/api/orval/axios-instance";

// ── Types بک‌اند ──────────────────────────────────────────────────────────────

export type BackendTicketStatus =
  | "OPEN"
  | "USER_REPLIED"
  | "ADMIN_REPLIED"
  | "CLOSED";

export type BackendTicketPriority = "LOW" | "MEDIUM" | "HIGH";

export interface BackendTicketMessage {
  id: string;
  sender: {
    id: string;
    username: string;
    phone_number: string;
  };
  message: string;
  attachment_url: string | null;
  created_at: string;
}

export interface BackendTicket {
  id: string;
  user: {
    id: string;
    username: string;
    phone_number: string;
  };
  subject: string;
  priority: BackendTicketPriority;
  status: BackendTicketStatus;
  created_at: string;
  updated_at: string;
}

export interface BackendTicketDetail extends BackendTicket {
  messages: BackendTicketMessage[];
}

export interface PaginatedTickets {
  count: number;
  next: string | null;
  previous: string | null;
  total_pages: number;
  current_page: number;
  results: BackendTicket[];
}

export interface CreateTicketPayload {
  subject: string;
  priority: BackendTicketPriority;
  message: string;
}

export interface ReplyTicketPayload {
  message: string;
  attachment_url?: string;
}

// ── Helper ────────────────────────────────────────────────────────────────────
interface ApiResponse<T> {
  success: boolean;
  data: T;
}

function unwrap<T>(response: { data: ApiResponse<T> | T }): T {
  const p = response.data;
  if (
    p &&
    typeof p === "object" &&
    "data" in p &&
    "success" in p
  ) {
    return (p as ApiResponse<T>).data;
  }
  return p as T;
}

// ── Service ───────────────────────────────────────────────────────────────────
export const ticketService = {
  getTickets: async (params?: {
    page?: number;
    page_size?: number;
  }): Promise<PaginatedTickets> => {
    const res = await axiosInstance.get("/tickets/", { params });
    return unwrap<PaginatedTickets>(res);
  },

  getTicketById: async (id: string): Promise<BackendTicketDetail> => {
    const res = await axiosInstance.get(`/tickets/${id}/`);
    return unwrap<BackendTicketDetail>(res);
  },

  createTicket: async (
    data: CreateTicketPayload
  ): Promise<BackendTicketDetail> => {
    const res = await axiosInstance.post("/tickets/", data);
    return unwrap<BackendTicketDetail>(res);
  },

  replyToTicket: async (
    id: string,
    data: ReplyTicketPayload
  ): Promise<{ id: string; created_at: string }> => {
    const res = await axiosInstance.post(`/tickets/${id}/reply/`, data);
    return unwrap<{ id: string; created_at: string }>(res);
  },

  closeTicket: async (id: string): Promise<void> => {
    await axiosInstance.post(`/tickets/${id}/close/`);
  },

  deleteTicket: async (id: string): Promise<void> => {
    await axiosInstance.delete(`/tickets/${id}/`);
  },
};
</file>

