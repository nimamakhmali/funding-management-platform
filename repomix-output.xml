    ctx.addIssue({
      code: z.ZodIssueCode.custom,
      message: "رمز عبور الزامی است",
    });
    return;
  }

  if (value.length < 8) {
    ctx.addIssue({
      code: z.ZodIssueCode.custom,
      message: "رمز عبور باید حداقل ۸ کاراکتر باشد",
