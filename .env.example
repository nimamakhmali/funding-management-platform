# ============================================
# متغیرهای زیرساخت (فقط برای docker-compose)
# این فایل را به .env کپی کنید و مقادیر را ویرایش کنید
# ============================================

# آدرس عمومی سرور — بدون http:// و بدون اسلش انتهایی
SERVER_IP=5.198.179.184

# اطلاعات دیتابیس (باید یک‌سان با محتوای backend/.env نباشد لازم نیست، این مقادیر ملاک هستند)
DB_NAME=investment_platform
DB_USER=postgres
DB_PASSWORD=change-this-strong-password

# پورت عمومی nginx
HTTP_PORT=80